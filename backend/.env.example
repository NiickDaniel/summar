# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# O ".env" nunca deve ser commitado.

# Porta em que a API Express sobe dentro do container
PORT=3000

# Origem(ns) liberada(s) para CORS. Use "*" em desenvolvimento.
CORS_ORIGIN=*

# --- Supabase ---
# URL do projeto (Project Settings > API > Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (Project Settings > API > service_role secret).
# É preciso a service_role (não a anon) para o backend inserir mensagens
# e gravar resumos ignorando o Row Level Security habilitado nas tabelas.
SUPABASE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
# Modelo usado para gerar os resumos diários
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp / EvolutionAPI ---
# ID do grupo da faculdade que deve ser monitorado (formato "xxxxx@g.us")
WHATSAPP_GROUP_ID=

# --- Cron do resumo diário ---
# Expressão cron (padrão: todo dia às 22h)
CRON_SCHEDULE=0 22 * * *
# Timezone do cron
CRON_TIMEZONE=America/Sao_Paulo
